# Local PostgreSQL (dev) — run: createdb gameon
DATABASE_URL="postgresql://localhost:5432/gameon"
# Production (Neon) — set this in Vercel env vars, not here
# DATABASE_URL="postgresql://neondb_owner:password@ep-xxx.neon.tech/neondb?sslmode=require&connect_timeout=15"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary — image storage (logos, covers, venue photos)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"


EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password