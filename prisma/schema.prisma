generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth required models ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Roles & Users ───────────────────────────────────────────────────────────

enum Role {
  PLAYER
  VENUE_OWNER
  STAFF
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          Role      @default(PLAYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Venues this user owns (VENUE_OWNER)
  ownedVenues Venue[] @relation("VenueOwner")

  // Venue this user works at (STAFF)
  staffVenueId String?
  staffVenue   Venue?  @relation("VenueStaff", fields: [staffVenueId], references: [id])

  accounts           Account[]
  sessions           Session[]
  notificationPrefs  NotificationPrefs?
  venueMemberships   VenueMember[]
  bookingsCreated    Booking[]          @relation("BookingCreatedBy")
  paymentsRecorded   Payment[]          @relation("PaymentRecordedBy")
  courtBlocksCreated CourtBlock[]       @relation("CourtBlockCreatedBy")
}

model NotificationPrefs {
  id            String  @id @default(cuid())
  userId        String  @unique
  newBooking    Boolean @default(false)
  cancellation  Boolean @default(false)
  payment       Boolean @default(false)
  checkin       Boolean @default(false)
  dailySummary  Boolean @default(false)
  weeklySummary Boolean @default(false)
  lowOccupancy  Boolean @default(false)
  smsAlerts     Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Venue ───────────────────────────────────────────────────────────────────

enum VenueType {
  PRIVATE
  PUBLIC
  SEMI_PUBLIC
}

enum VenueStatus {
  ACTIVE
  TEMPORARILY_CLOSED
  MAINTENANCE
}

enum OnboardingStep {
  FACILITY
  SPORTS
  HOURS
  COURTS
  PRICING
  DONE
}

model Venue {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  description    String?
  type           VenueType      @default(PRIVATE)
  status         VenueStatus    @default(ACTIVE)
  phone          String?
  email          String?
  website        String?
  address        String?
  city           String?
  state          String?
  zip            String?
  country        String?
  latitude       Float?
  longitude      Float?
  timezone       String         @default("UTC") // IANA zone, e.g. America/Phoenix
  currency       String         @default("USD") // ISO 4217 code used for display
  onboardingStep OnboardingStep @default(FACILITY)
  isSetupDone    Boolean        @default(false)
  ownerId        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  owner           User             @relation("VenueOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  staff           User[]           @relation("VenueStaff")
  courts          Court[]
  sports          Sport[]
  images          VenueImage[]
  amenities       VenueAmenity[]
  operatingHours  OperatingHours[]
  pricingRules    PricingRule[]
  bookings        Booking[]
  walkIns         WalkInBooking[]
  courtBlocks     CourtBlock[]
  players         Player[]
  membershipPlans MembershipPlan[]
  memberships     Membership[]
  classes         Class[]
  venueRoles      VenueRole[]
  tournaments     Tournament[]
  venueMembers    VenueMember[]
}

// ─── Venue Roles & Members ────────────────────────────────────────────────────

enum VenueRolePreset {
  MANAGER
  EMPLOYEE
}

model VenueRole {
  id          String           @id @default(cuid())
  venueId     String
  // Built-in roles every venue gets. Their permissions are fixed in code
  // (lib/team/presets.ts) and they cannot be renamed or deleted.
  preset      VenueRolePreset?
  name        String
  color       String           @default("#16a34a")
  // permissions stored as JSON: { bookings, venue, reports, billing, team }
  // each value: "none" | "view" | "edit"
  permissions Json             @default("{}")
  createdAt   DateTime         @default(now())

  venue   Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  members VenueMember[]

  @@unique([venueId, preset])
}

model VenueMember {
  id           String    @id @default(cuid())
  venueId      String
  userId       String?
  roleId       String?
  email        String
  name         String
  status       String    @default("invited") // invited | active
  inviteToken  String?   @unique
  inviteExpiry DateTime?
  createdAt    DateTime  @default(now())

  venue Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  role  VenueRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([venueId, email])
}

// ─── Venue Amenities ──────────────────────────────────────────────────────────

model VenueAmenity {
  id      String @id @default(cuid())
  venueId String
  name    String

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, name])
}

// ─── Venue Images ─────────────────────────────────────────────────────────────

model VenueImage {
  id       String  @id @default(cuid())
  venueId  String
  imageUrl String
  isCover  Boolean @default(false)
  isLogo   Boolean @default(false)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

// ─── Sports (venue-specific, no hardcoded enum) ───────────────────────────────

model Sport {
  id      String  @id @default(cuid())
  venueId String
  name    String
  emoji   String?

  venue           Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  courts          Court[]
  operatingHours  OperatingHours[]
  pricingRules    PricingRule[]
  bookings        Booking[]
  membershipPlans MembershipPlan[]
  classes         Class[]

  tournaments Tournament[]

  @@unique([venueId, name])
}

// ─── Courts ──────────────────────────────────────────────────────────────────

enum CourtType {
  INDOOR
  OUTDOOR
}

model Court {
  id          String    @id @default(cuid())
  venueId     String
  sportId     String?
  name        String
  type        CourtType @default(INDOOR)
  capacity    Int       @default(4)
  description String?
  images      String[]  @default([])
  isActive    Boolean   @default(true)
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sport        Sport?        @relation(fields: [sportId], references: [id], onDelete: SetNull)
  bookings     Booking[]
  pricingRules PricingRule[]
  blocks       CourtBlock[]
}

// ─── Operating Hours ─────────────────────────────────────────────────────────

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model OperatingHours {
  id        String    @id @default(cuid())
  venueId   String
  sportId   String?
  day       DayOfWeek
  openTime  String
  closeTime String
  isClosed  Boolean   @default(false)

  venue Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sport Sport? @relation(fields: [sportId], references: [id], onDelete: Cascade)
}

// ─── Pricing ─────────────────────────────────────────────────────────────────

model PricingRule {
  id        String   @id @default(cuid())
  venueId   String
  sportId   String?
  courtId   String?
  label     String
  days      String
  startTime String
  endTime   String
  priceUsd  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  venue Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sport Sport? @relation(fields: [sportId], references: [id], onDelete: SetNull)
  court Court? @relation(fields: [courtId], references: [id])
}

// ─── Bookings ────────────────────────────────────────────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum BookingSource {
  WALK_IN
  PHONE
  WHATSAPP
  GAMEON
  PLAYO
  DISTRICT
  OTHER
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum PaymentKind {
  PAYMENT
  REFUND
}

// No two non-cancelled bookings may overlap on the same court. This is enforced in
// PostgreSQL by the "Booking_no_overlap" exclusion constraint (see migration
// 1_phase1_booking_engine), which Prisma cannot express in this schema.
model Booking {
  id              String        @id @default(cuid())
  venueId         String
  courtId         String
  sportId         String?
  customer        String
  phone           String?
  email           String?
  sport           String? // display name snapshot (legacy rows have no sportId)
  source          BookingSource @default(OTHER)
  startTime       DateTime
  endTime         DateTime
  amountUsd       Decimal       @db.Decimal(10, 2) // booked price, in the venue currency
  priceOverridden Boolean       @default(false)
  payment         PaymentStatus @default(PENDING) // summary, derived from Payment rows
  status          BookingStatus @default(CONFIRMED)
  notes           String?
  cancelledAt     DateTime?
  cancelReason    String?
  createdById     String?
  playerId        String? // set for members (and any saved player)
  membershipId    String? // set when the court time is covered by a membership
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  venue      Venue       @relation(fields: [venueId], references: [id])
  court      Court       @relation(fields: [courtId], references: [id])
  player     Player?     @relation(fields: [playerId], references: [id], onDelete: SetNull)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  sportRef   Sport?      @relation(fields: [sportId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments   Payment[]

  @@index([venueId, startTime])
  @@index([courtId, startTime])
}

// Money actually received (PAYMENT) or returned (REFUND) for a booking.
// Collected revenue is computed from these rows, never from Booking.amountUsd.
// Exactly one of bookingId / membershipId / enrollmentId / tournamentEntryId is set
// ("Payment_one_target" check constraint, last updated in migration 4_tournaments).
model Payment {
  id                String        @id @default(cuid())
  bookingId         String?
  membershipId      String?
  enrollmentId      String?
  tournamentEntryId String?
  venueId           String
  kind              PaymentKind   @default(PAYMENT)
  method            PaymentMethod
  amount            Decimal       @db.Decimal(10, 2)
  receivedAt        DateTime      @default(now())
  note              String?
  recordedById      String?
  createdAt         DateTime      @default(now())

  booking         Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  membership      Membership?        @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  enrollment      Enrollment?        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  tournamentEntry TournamentEntrant? @relation(fields: [tournamentEntryId], references: [id], onDelete: Cascade)
  recordedBy      User?              @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([venueId, receivedAt])
  @@index([bookingId])
  @@index([membershipId])
  @@index([enrollmentId])
  @@index([tournamentEntryId])
}

// Maintenance / unavailable periods for a court. Non-overlapping per court
// ("CourtBlock_no_overlap" exclusion constraint).
model CourtBlock {
  id           String   @id @default(cuid())
  venueId      String
  courtId      String
  startTime    DateTime
  endTime      DateTime
  reason       String?
  classId      String? // set when this block is a session of a coaching class
  tournamentId String? // set when this block reserves a court for a tournament
  createdById  String?
  createdAt    DateTime @default(now())

  venue      Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  court      Court       @relation(fields: [courtId], references: [id], onDelete: Cascade)
  class      Class?      @relation(fields: [classId], references: [id], onDelete: Cascade)
  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdBy  User?       @relation("CourtBlockCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([courtId, startTime])
  @@index([classId, startTime])
  @@index([tournamentId, startTime])
}

// ─── Players, memberships, classes ────────────────────────────────────────────

// A venue's customer record (members and students). Players don't log in.
model Player {
  id        String   @id @default(cuid())
  venueId   String
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  memberships Membership[]
  enrollments Enrollment[]
  bookings    Booking[]

  tournamentEntries TournamentEntrant[]

  @@index([venueId, name])
}

model MembershipPlan {
  id             String   @id @default(cuid())
  venueId        String
  name           String
  description    String?
  durationMonths Int // 1 = monthly, 12 = yearly, …
  price          Decimal  @db.Decimal(10, 2)
  sportId        String? // null = all sports
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sport       Sport?       @relation(fields: [sportId], references: [id], onDelete: SetNull)
  memberships Membership[]
}

enum MembershipStatus {
  ACTIVE
  CANCELLED
}

// startDate/endDate are venue-local dates ('YYYY-MM-DD', inclusive). Expiry is derived from endDate.
model Membership {
  id          String           @id @default(cuid())
  venueId     String
  playerId    String
  planId      String
  startDate   String
  endDate     String
  price       Decimal          @db.Decimal(10, 2)
  status      MembershipStatus @default(ACTIVE)
  cancelledAt DateTime?
  createdById String?
  createdAt   DateTime         @default(now())

  venue    Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  player   Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  plan     MembershipPlan @relation(fields: [planId], references: [id])
  payments Payment[]
  bookings Booking[]

  @@index([venueId, endDate])
  @@index([playerId])
}

enum ClassStatus {
  ACTIVE
  CANCELLED
}

enum FeePeriod {
  MONTH
  TERM
}

// A recurring coaching class. Each session is materialised as CourtBlock rows
// (one per court per class day), so courts are reserved with the same
// no-overlap guarantee as bookings.
model Class {
  id          String      @id @default(cuid())
  venueId     String
  name        String
  coachName   String?
  sportId     String?
  courtIds    String[]
  days        DayOfWeek[]
  startMin    Int // minutes after local midnight
  endMin      Int
  startDate   String // venue-local 'YYYY-MM-DD', inclusive
  endDate     String
  capacity    Int?
  fee         Decimal     @db.Decimal(10, 2)
  feePeriod   FeePeriod   @default(MONTH)
  status      ClassStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sport       Sport?       @relation(fields: [sportId], references: [id], onDelete: SetNull)
  sessions    CourtBlock[]
  enrollments Enrollment[]

  @@index([venueId, status])
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
}

model Enrollment {
  id          String           @id @default(cuid())
  venueId     String
  classId     String
  playerId    String
  status      EnrollmentStatus @default(ACTIVE)
  withdrawnAt DateTime?
  createdById String?
  createdAt   DateTime         @default(now())

  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  player   Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([classId, playerId])
  @@index([venueId])
}

// ─── Password Reset OTP ──────────────────────────────────────────────────────

model PasswordResetOtp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Walk-in Bookings (DEPRECATED) ───────────────────────────────────────────
// Unused. Walk-ins are stored in Booking with source = WALK_IN so the no-overlap
// constraint covers them. Kept only to avoid a destructive drop; remove later.

model WalkInBooking {
  id           String   @id @default(cuid())
  venueId      String
  courtId      String?
  customerName String
  phone        String?
  sport        String?
  startTime    DateTime
  endTime      DateTime
  amountUsd    Decimal  @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id])
}

// ─── Tournaments ──────────────────────────────────────────────────────────────

enum TournamentStatus {
  REGISTRATION // taking entries
  IN_PROGRESS // bracket drawn, matches being played
  COMPLETED
  CANCELLED
}

enum TournamentEntryType {
  SINGLES
  DOUBLES
  TEAM
}

enum MatchStatus {
  PENDING
  COMPLETED
}

// A knockout tournament. Its courts are reserved every day from startDate to
// endDate between startMin and endMin (CourtBlock rows with tournamentId).
model Tournament {
  id              String              @id @default(cuid())
  venueId         String
  name            String
  description     String?
  sportId         String?
  courtIds        String[]
  startDate       String // venue-local 'YYYY-MM-DD', inclusive
  endDate         String
  startMin        Int
  endMin          Int
  entryType       TournamentEntryType @default(SINGLES)
  maxEntrants     Int?
  entryFee        Decimal             @db.Decimal(10, 2)
  // [{ label: "Winner", amount: 500, paid: false }, …] in finishing order
  prizes          Json                @default("[]")
  status          TournamentStatus    @default(REGISTRATION)
  winnerEntrantId String?
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  venue    Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sport    Sport?              @relation(fields: [sportId], references: [id], onDelete: SetNull)
  sessions CourtBlock[]
  entrants TournamentEntrant[]
  matches  TournamentMatch[]

  @@index([venueId, status])
}

// One entry: a player, a pair or a team.
model TournamentEntrant {
  id           String   @id @default(cuid())
  tournamentId String
  venueId      String
  name         String // display name, e.g. "Asha Rao" or "Asha / Ravi"
  playerId     String? // linked player record (main contact)
  phone        String?
  seed         Int?
  withdrawn    Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player?           @relation(fields: [playerId], references: [id], onDelete: SetNull)
  payments   Payment[]
  matchesA   TournamentMatch[] @relation("MatchEntrantA")
  matchesB   TournamentMatch[] @relation("MatchEntrantB")
  matchesWon TournamentMatch[] @relation("MatchWinner")

  @@index([tournamentId])
}

// A knockout match. Round 1 is the first round; the winner of (round r, position p)
// moves to (round r+1, position floor(p/2)), slot A if p is even, B if odd.
model TournamentMatch {
  id           String      @id @default(cuid())
  tournamentId String
  round        Int
  position     Int
  entrantAId   String?
  entrantBId   String?
  winnerId     String?
  score        String?
  courtId      String?
  scheduledAt  DateTime?
  status       MatchStatus @default(PENDING)
  updatedAt    DateTime    @updatedAt

  tournament Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  entrantA   TournamentEntrant? @relation("MatchEntrantA", fields: [entrantAId], references: [id], onDelete: SetNull)
  entrantB   TournamentEntrant? @relation("MatchEntrantB", fields: [entrantBId], references: [id], onDelete: SetNull)
  winner     TournamentEntrant? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, round, position])
}
